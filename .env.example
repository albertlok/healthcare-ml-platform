# ─────────────────────────────────────────────────────────────
# healthcare-ml-platform  —  Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── General ───────────────────────────────────────────────────
ENVIRONMENT=dev                        # dev | staging | prod
PROJECT_NAME=healthcare-ml-platform
LOG_LEVEL=INFO

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_TOPIC_APPOINTMENTS=dev.healthcare.appointment.scheduled
KAFKA_TOPIC_PATIENTS=dev.healthcare.patient.registered
KAFKA_TOPIC_CANCELLATIONS=dev.healthcare.appointment.cancelled
KAFKA_TOPIC_COMPLETIONS=dev.healthcare.appointment.completed
KAFKA_CONSUMER_GROUP=healthcare-ml-consumer

# Cloud equivalents (uncomment when using cloud Kafka)
# AWS MSK
# KAFKA_BOOTSTRAP_SERVERS=<broker>.kafka.<region>.amazonaws.com:9092
# MSK_IAM_ROLE_ARN=arn:aws:iam::<account>:role/<role>

# Confluent Cloud (free tier)
# KAFKA_BOOTSTRAP_SERVERS=<cluster>.confluent.cloud:9092
# CONFLUENT_API_KEY=
# CONFLUENT_API_SECRET=

# Azure Event Hubs (Kafka protocol)
# KAFKA_BOOTSTRAP_SERVERS=<namespace>.servicebus.windows.net:9093
# EVENTHUB_CONNECTION_STRING=

# ── Object Storage ────────────────────────────────────────────
# Local (MinIO)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
DELTA_LAKE_PATH=s3a://healthcare

# AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# DELTA_LAKE_PATH=s3a://your-bucket/healthcare

# Azure ADLS Gen2
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# DELTA_LAKE_PATH=abfss://healthcare@<account>.dfs.core.windows.net

# GCP GCS
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCP_PROJECT_ID=
# DELTA_LAKE_PATH=gs://your-bucket/healthcare

# ── Data Warehouse ────────────────────────────────────────────
# DuckDB (local dev — zero config)
DUCKDB_PATH=./data/dev.duckdb

# Snowflake (free trial or prod)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=dev_healthcare
SNOWFLAKE_SCHEMA=silver

# Azure Synapse
# SYNAPSE_SERVER=<workspace>.sql.azuresynapse.net
# SYNAPSE_DATABASE=healthcare
# SYNAPSE_USER=
# SYNAPSE_PASSWORD=

# GCP BigQuery
# BIGQUERY_PROJECT=
# BIGQUERY_DATASET=healthcare

# ── Airflow ───────────────────────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=                    # Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__WEBSERVER__SECRET_KEY=               # Random string

# ── Spark ─────────────────────────────────────────────────────
SPARK_MASTER_URL=spark://localhost:7077       # local[*] for pure local mode
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=2

# ── Feature Store (Feast) ─────────────────────────────────────
FEAST_REPO_PATH=./feature_store/feature_repo
FEAST_ONLINE_STORE=sqlite                     # sqlite | redis | dynamodb | datastore
FEAST_OFFLINE_STORE=duckdb                    # duckdb | snowflake | bigquery | redshift

# Redis online store (for low-latency serving)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ── MLflow ────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=patient-no-show
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000  # Point to MinIO locally
MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts/

# ── DVC ───────────────────────────────────────────────────────
DVC_REMOTE=local                              # local | s3 | gs | azure | gdrive
DVC_REMOTE_URL=./data/.dvc-cache             # Change to s3://bucket/dvc for cloud

# ── Vector Store (ChromaDB) ───────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_CLINICAL_NOTES=clinical_notes
CHROMA_COLLECTION_PATIENT_SUMMARIES=patient_summaries

# ── Embedding Model ───────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # Free, runs locally
EMBEDDING_DEVICE=cpu                                       # cpu | cuda | mps (Apple Silicon)

# ── LLM (optional — RAG generation layer) ────────────────────
# Anthropic Claude (optional — falls back to local LLM if unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local LLM fallback (Ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ── Great Expectations ────────────────────────────────────────
GX_ROOT_DIR=./quality

# ── Evidently (drift monitoring) ──────────────────────────────
EVIDENTLY_REPORT_PATH=./reports/drift
DRIFT_P_VALUE_THRESHOLD=0.05

# ── Notifications (optional) ─────────────────────────────────
# Slack — used in Airflow on_failure_callback
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#data-alerts

# PagerDuty — production alerting
PAGERDUTY_INTEGRATION_KEY=
